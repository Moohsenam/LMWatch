<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ClaudeWatch.Orders</RootNamespace>
    <AssemblyName>ClaudeWatch.Orders</AssemblyName>
    <Version>1.0.0</Version>
    <!-- No third-party packages on purpose: everything here ships with the .NET
         runtime, so the server builds and runs on a machine with no internet. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
