# /etc/systemd/system/cw-orders.service
#
# The port, the data folder and the bind address all live in /etc/cw-orders.conf.
# Change it there, then:  systemctl restart cw-orders
[Unit]
Description=SafeChat orders
After=network.target

[Service]
Type=simple
User=cworders
WorkingDirectory=/opt/cw-orders
ExecStart=/usr/bin/dotnet /opt/cw-orders/ClaudeWatch.Orders.dll
EnvironmentFile=/etc/cw-orders.conf
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cw-orders

[Install]
WantedBy=multi-user.target
