<Window x:Class="ClaudeWatch.App.GraceOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Watch"
        Width="620" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FlowDirection="{Binding Flow}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        MouseLeftButtonDown="OnDrag">

    <!-- Deliberately a banner and not a full-screen cover: the whole point is
         that you can still reach your VPN client while this is up. -->
    <Border Margin="16" CornerRadius="16" Padding="24"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Alert}" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.55" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- countdown dial -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <Grid Width="88" Height="88">
                    <Ellipse Fill="{DynamicResource AlertSoft}" />
                    <Ellipse x:Name="Ring" Width="74" Height="74" Stroke="{DynamicResource Alert}"
                             StrokeThickness="3" Opacity="0.45" />
                    <TextBlock x:Name="Countdown" Text="10" FontSize="34" FontWeight="Bold"
                               Foreground="{DynamicResource Alert}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Path x:Name="Tick" Width="34" Height="34" Stretch="Uniform" Visibility="Collapsed"
                          Fill="{DynamicResource Good}" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z" />
                </Grid>
                <TextBlock x:Name="Caption" Text="{Binding L[Grace_Closing]}" Style="{StaticResource Caption}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="96" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
                <TextBlock x:Name="Headline" Text="{Binding GraceTitle}" Style="{StaticResource Display}"
                           FontSize="22" Foreground="{DynamicResource Alert}" />
                <TextBlock x:Name="Body" Text="{Binding GraceBody}" Style="{StaticResource Dim}"
                           Margin="0,6,0,0" />

                <Border x:Name="BarTrack" Height="5" CornerRadius="3" Margin="0,14,0,0"
                        Background="{DynamicResource SurfaceAlt}" HorizontalAlignment="Stretch">
                    <Border x:Name="BarFill" Height="5" CornerRadius="3" HorizontalAlignment="Left"
                            Background="{DynamicResource Alert}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <Button x:Name="StopNow" Content="{Binding L[Grace_StopNow]}"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding StopClaudeCommand}" MinWidth="150" />
                <Button x:Name="OpenApp" Content="{Binding L[App_Name]}"
                        Style="{StaticResource GhostButton}" Margin="0,6,0,0"
                        Click="OnOpenApp" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
