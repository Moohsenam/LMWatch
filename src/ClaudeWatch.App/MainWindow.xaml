<Window x:Class="ClaudeWatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:ClaudeWatch.App.Views"
        Title="Claude Watch"
        Height="720" Width="1080" MinHeight="580" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource Bg}"
        Icon="/Assets/app.ico"
        FlowDirection="{Binding Flow}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootShell" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================ sidebar ============================ -->
            <Border Grid.Column="0" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- brand -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,18,20,22">
                        <Grid Width="30" Height="30" VerticalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="3.5" />
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource Text}" />
                        </Grid>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding L[App_Name]}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding L[App_Tagline]}" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- navigation -->
                    <StackPanel Grid.Row="1">
                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}"
                                     IsChecked="{Binding IsDashboard, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" Margin="2,0,11,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z" />
                                <TextBlock Text="{Binding L[Nav_Dashboard]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}"
                                     IsChecked="{Binding IsBuy, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Buy">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" Margin="2,0,11,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M7,7 V5.5 A5,5 0 0 1 17,5.5 V7 H20 L19,21 H5 L4,7 Z M9,7 H15 V5.5 A3,3 0 0 0 9,5.5 Z" />
                                <TextBlock Text="{Binding L[Nav_Buy]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}"
                                     IsChecked="{Binding IsOrders, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Orders">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" Margin="2,0,11,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M5,3 H19 V21 H5 Z M8,7 H16 V9 H8 Z M8,11 H16 V13 H8 Z M8,15 H13 V17 H8 Z" />
                                <TextBlock Text="{Binding L[Nav_Orders]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}"
                                     IsChecked="{Binding IsUsage, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Usage">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" Margin="2,0,11,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M3,13 H7 V21 H3 Z M10,7 H14 V21 H10 Z M17,3 H21 V21 H17 Z" />
                                <TextBlock Text="{Binding L[Nav_Usage]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}"
                                     IsChecked="{Binding IsProcesses, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Processes">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" Margin="2,0,11,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M3,4 H21 V8 H3 Z M3,10 H15 V14 H3 Z M3,16 H18 V20 H3 Z" />
                                <TextBlock Text="{Binding L[Nav_Processes]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}"
                                     IsChecked="{Binding IsNetwork, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Network">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" Margin="2,0,11,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M3,17 H6 V21 H3 Z M9,13 H12 V21 H9 Z M15,8 H18 V21 H15 Z" />
                                <TextBlock Text="{Binding L[Nav_Network]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}"
                                     IsChecked="{Binding IsActivity, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Activity">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" Margin="2,0,11,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M11,6 H13 V13 H18 V15 H11 Z" />
                                <TextBlock Text="{Binding L[Nav_Activity]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}"
                                     IsChecked="{Binding IsSettings, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" Margin="2,0,11,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M3,6 H21 V8 H3 Z M3,16 H21 V18 H3 Z M7,3 H9.5 V11 H7 Z M14.5,13 H17 V21 H14.5 Z" />
                                <TextBlock Text="{Binding L[Nav_Settings]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}"
                                     IsChecked="{Binding IsAbout, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="About">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" Margin="2,0,11,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M11,6 H13 V9 H11 Z M11,11 H13 V18 H11 Z" />
                                <TextBlock Text="{Binding L[Nav_About]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- footer: state pill and the two clocks -->
                    <StackPanel Grid.Row="2" Margin="16,0,16,16">
                        <Border Background="{Binding StatusSoftBrush}" CornerRadius="9" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusTitle}" Margin="9,0,0,0" VerticalAlignment="Center"
                                           FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="4,14,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding L[Clock_Home]}" Style="{StaticResource Caption}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding HomeClock}" Style="{StaticResource Body}" FontSize="16"
                                           FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding L[Clock_Work]}" Style="{StaticResource Caption}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding WorkClock}" Style="{StaticResource Body}" FontSize="16"
                                           FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================= content ============================ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- title bar -->
                <Grid Grid.Row="0" Background="{DynamicResource Bg}">
                    <TextBlock Text="{Binding HeaderSummary}" VerticalAlignment="Center" Margin="24,0,0,0"
                               Style="{StaticResource Caption}" FontSize="11.5" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButton}" Click="OnMinimize"
                                ToolTip="{Binding L[Btn_Minimize]}">
                            <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource TextDim}"
                                  Data="M2,11 H20 V13 H2 Z" />
                        </Button>
                        <Button Style="{StaticResource CaptionButton}" Click="OnMaximize">
                            <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource TextDim}"
                                  Data="M3,3 H21 V21 H3 Z M6,6 V18 H18 V6 Z" />
                        </Button>
                        <Button Style="{StaticResource CloseButton}" Click="OnClose" ToolTip="{Binding L[Btn_Close]}">
                            <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource TextDim}"
                                  Data="M4.6,3 L12,10.4 L19.4,3 L21,4.6 L13.6,12 L21,19.4 L19.4,21 L12,13.6 L4.6,21 L3,19.4 L10.4,12 L3,4.6 Z" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- pages -->
                <Grid Grid.Row="1">
                    <views:DashboardView Visibility="{Binding IsDashboard, Converter={StaticResource BoolVis}}" />
                    <views:BuyView Visibility="{Binding IsBuy, Converter={StaticResource BoolVis}}" />
                    <views:OrdersView Visibility="{Binding IsOrders, Converter={StaticResource BoolVis}}" />
                    <views:UsageView Visibility="{Binding IsUsage, Converter={StaticResource BoolVis}}" />
                    <views:ProcessesView Visibility="{Binding IsProcesses, Converter={StaticResource BoolVis}}" />
                    <views:NetworkView Visibility="{Binding IsNetwork, Converter={StaticResource BoolVis}}" />
                    <views:ActivityView Visibility="{Binding IsActivity, Converter={StaticResource BoolVis}}" />
                    <views:SettingsView Visibility="{Binding IsSettings, Converter={StaticResource BoolVis}}" />
                    <views:AboutView Visibility="{Binding IsAbout, Converter={StaticResource BoolVis}}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
