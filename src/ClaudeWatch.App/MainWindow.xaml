<Window x:Class="ClaudeWatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:ClaudeWatch.App.Views"
        Title="SafeChat"
        Height="720" Width="1080" MinHeight="580" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource Bg}"
        Icon="/Assets/app.ico"
        FlowDirection="{Binding Flow}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!-- Shortcuts for the things done most: the pages, a refresh, and the two
         buttons that matter when something is wrong. Ctrl so nothing fires
         while a name is being typed into a settings box. -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
        <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="Buy" />
        <KeyBinding Modifiers="Ctrl" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="Orders" />
        <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="Licence" />
        <KeyBinding Modifiers="Ctrl" Key="D5" Command="{Binding NavigateCommand}" CommandParameter="Processes" />
        <KeyBinding Modifiers="Ctrl" Key="D6" Command="{Binding NavigateCommand}" CommandParameter="Network" />
        <KeyBinding Modifiers="Ctrl" Key="D7" Command="{Binding NavigateCommand}" CommandParameter="Activity" />
        <KeyBinding Modifiers="Ctrl" Key="D8" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="R" Command="{Binding RefreshCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenClaudeCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding StopClaudeCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Tab" Command="{Binding NextServiceCommand}" />
    </Window.InputBindings>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootShell" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================ sidebar ============================ -->
            <Border Grid.Column="0" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- brand -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,18,20,22">
                        <Grid Width="30" Height="30" VerticalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="3.5" />
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource Text}" />
                        </Grid>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding L[App_Name]}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding ActiveServiceName}" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- navigation -->
                    <StackPanel Grid.Row="1">
                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}"
                                     IsChecked="{Binding IsDashboard, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" Margin="2,0,11,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z" />
                                <TextBlock Text="{Binding L[Nav_Dashboard]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}"
                                     IsChecked="{Binding IsBuy, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Buy">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" Margin="2,0,11,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M7,7 V5.5 A5,5 0 0 1 17,5.5 V7 H20 L19,21 H5 L4,7 Z M9,7 H15 V5.5 A3,3 0 0 0 9,5.5 Z" />
                                <TextBlock Text="{Binding L[Nav_Buy]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}"
                                     IsChecked="{Binding IsOrders, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Orders">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" Margin="2,0,11,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M5,3 H19 V21 H5 Z M8,7 H16 V9 H8 Z M8,11 H16 V13 H8 Z M8,15 H13 V17 H8 Z" />
                                <TextBlock Text="{Binding L[Nav_Orders]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}"
                                     IsChecked="{Binding IsLicence, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Licence">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" Margin="2,0,11,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M14,3 A6,6 0 1 0 8.6,11.6 L10,13 L10,15 L12,15 L12,17 L14,17 L14,19 L18,19 L21,16 L14,9 A6,6 0 0 0 14,3 Z M16.5,6 A1.5,1.5 0 1 1 16.5,9 A1.5,1.5 0 0 1 16.5,6 Z" />
                                <TextBlock Text="{Binding L[Nav_Licence]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}"
                                     IsChecked="{Binding IsProcesses, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Processes">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" Margin="2,0,11,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M3,4 H21 V8 H3 Z M3,10 H15 V14 H3 Z M3,16 H18 V20 H3 Z" />
                                <TextBlock Text="{Binding L[Nav_Processes]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}"
                                     IsChecked="{Binding IsNetwork, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Network">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" Margin="2,0,11,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M3,17 H6 V21 H3 Z M9,13 H12 V21 H9 Z M15,8 H18 V21 H15 Z" />
                                <TextBlock Text="{Binding L[Nav_Network]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}"
                                     IsChecked="{Binding IsActivity, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Activity">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" Margin="2,0,11,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M11,6 H13 V13 H18 V15 H11 Z" />
                                <TextBlock Text="{Binding L[Nav_Activity]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}"
                                     IsChecked="{Binding IsSettings, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" Margin="2,0,11,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M3,6 H21 V8 H3 Z M3,16 H21 V18 H3 Z M7,3 H9.5 V11 H7 Z M14.5,13 H17 V21 H14.5 Z" />
                                <TextBlock Text="{Binding L[Nav_Settings]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="nav" Style="{StaticResource NavItem}"
                                     IsChecked="{Binding IsAbout, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="About">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Stretch="Uniform" Margin="2,0,11,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M11,6 H13 V9 H11 Z M11,11 H13 V18 H11 Z" />
                                <TextBlock Text="{Binding L[Nav_About]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- footer: licence, state pill and the two clocks -->
                    <StackPanel Grid.Row="2" Margin="16,0,16,16">

                        <!-- What the licence is and how long is left. Clicking it
                             goes to the page that can do something about it. -->
                        <Button Style="{StaticResource ButtonBase}" Padding="0" Margin="0,0,0,12"
                                HorizontalContentAlignment="Stretch" Background="Transparent"
                                Command="{Binding NavigateCommand}" CommandParameter="Licence">
                            <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1" CornerRadius="9" Padding="12,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding LicenceBarTitle}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding LicenceBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding LicenceBarValue}"
                                                   Style="{StaticResource Caption}" FontSize="11"
                                                   Margin="8,0,0,0" />
                                    </Grid>

                                    <ProgressBar Height="3" Minimum="0" Maximum="1" Margin="0,8,0,0"
                                                 Value="{Binding LicenceBarFill, Mode=OneWay}"
                                                 Foreground="{Binding LicenceBrush}"
                                                 Background="{DynamicResource Line}"
                                                 BorderThickness="0" />

                                    <TextBlock Text="{Binding LicenceBarAccount}" Style="{StaticResource Caption}"
                                               FontSize="10.5" Margin="0,7,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Button>

                        <Border Background="{Binding StatusSoftBrush}" CornerRadius="9" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusTitle}" Margin="9,0,0,0" VerticalAlignment="Center"
                                           FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="4,14,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding L[Clock_Home]}" Style="{StaticResource Caption}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding HomeClock}" Style="{StaticResource Body}" FontSize="16"
                                           FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding L[Clock_Work]}" Style="{StaticResource Caption}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding WorkClock}" Style="{StaticResource Body}" FontSize="16"
                                           FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================= content ============================ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- title bar -->
                <Grid Grid.Row="0" Background="{DynamicResource Bg}">
                    <TextBlock Text="{Binding HeaderSummary}" VerticalAlignment="Center" Margin="24,0,0,0"
                               Style="{StaticResource Caption}" FontSize="11.5" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButton}" Click="OnMinimize"
                                ToolTip="{Binding L[Btn_Minimize]}">
                            <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource TextDim}"
                                  Data="M2,11 H20 V13 H2 Z" />
                        </Button>
                        <Button Style="{StaticResource CaptionButton}" Click="OnMaximize">
                            <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource TextDim}"
                                  Data="M3,3 H21 V21 H3 Z M6,6 V18 H18 V6 Z" />
                        </Button>
                        <Button Style="{StaticResource CloseButton}" Click="OnClose" ToolTip="{Binding L[Btn_Close]}">
                            <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource TextDim}"
                                  Data="M4.6,3 L12,10.4 L19.4,3 L21,4.6 L13.6,12 L21,19.4 L19.4,21 L12,13.6 L4.6,21 L3,19.4 L10.4,12 L3,4.6 Z" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Which app is being guarded, said loudly. The whole strip takes
                     that service's colour, so switching is impossible to miss. -->
                <Border Grid.Row="1" Background="{DynamicResource AccentSoft}"
                        BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,2"
                        Padding="24,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                Background="{DynamicResource Accent}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveServiceInitial}" FontSize="19" FontWeight="Bold"
                                       Foreground="{DynamicResource OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveServiceName}" FontSize="17" FontWeight="Bold"
                                       Foreground="{DynamicResource Accent}" />
                            <TextBlock Text="{Binding ActiveServiceLine}" Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <ItemsControl Grid.Column="2" ItemsSource="{Binding ServiceTabs}"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding ShowServiceSwitch, Converter={StaticResource BoolVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ServiceTab}"
                                            Content="{Binding Name}"
                                            Tag="{Binding Selected}"
                                            MinWidth="104"
                                            BorderBrush="{Binding Accent}"
                                            Visibility="{Binding Enabled, Converter={StaticResource BoolVis}}"
                                            Command="{Binding DataContext.SwitchServiceCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Key}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- A new build is waiting. It sits above every page rather than
                     on one of them, because it is about the app itself, and it
                     stays out of the way until someone answers it. -->
                <Border Grid.Row="2" Background="{DynamicResource InfoSoft}"
                        BorderBrush="{DynamicResource Info}" BorderThickness="0,0,0,1"
                        Padding="24,11"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                                 Fill="{DynamicResource Info}" />

                        <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UpdateTitle}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Info}" />
                            <TextBlock Text="{Binding UpdateDetail}" Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />

                            <ProgressBar Height="3" Minimum="0" Maximum="100" Margin="0,8,0,0"
                                         Value="{Binding UpdatePercent, Mode=OneWay}"
                                         Foreground="{DynamicResource Info}"
                                         Background="{DynamicResource Line}" BorderThickness="0"
                                         Visibility="{Binding UpdateWorking, Converter={StaticResource BoolVis}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding L[Upd_Install]}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding StartUpdateCommand}"
                                    IsEnabled="{Binding UpdateCanStart}"
                                    Visibility="{Binding UpdateWorking, Converter={StaticResource NotBoolVis}}" />
                            <Button Content="{Binding L[Upd_Later]}" Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" Command="{Binding DismissUpdateCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- pages -->
                <Grid Grid.Row="3">
                    <views:DashboardView Visibility="{Binding IsDashboard, Converter={StaticResource BoolVis}}" />
                    <views:BuyView Visibility="{Binding IsBuy, Converter={StaticResource BoolVis}}" />
                    <views:OrdersView Visibility="{Binding IsOrders, Converter={StaticResource BoolVis}}" />
                    <views:LicenceView Visibility="{Binding IsLicence, Converter={StaticResource BoolVis}}" />
                    <views:ProcessesView Visibility="{Binding IsProcesses, Converter={StaticResource BoolVis}}" />
                    <views:NetworkView Visibility="{Binding IsNetwork, Converter={StaticResource BoolVis}}" />
                    <views:ActivityView Visibility="{Binding IsActivity, Converter={StaticResource BoolVis}}" />
                    <views:SettingsView Visibility="{Binding IsSettings, Converter={StaticResource BoolVis}}" />
                    <views:AboutView Visibility="{Binding IsAbout, Converter={StaticResource BoolVis}}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
