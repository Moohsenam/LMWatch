    <SolidColorBrush x:Key="WarnSoft" Color="#D9A15B" Opacity="0.14" />
    <SolidColorBrush x:Key="AlertSoft" Color="#D2615A" Opacity="0.14" />
    <SolidColorBrush x:Key="InfoSoft" Color="#7C9CC9" Opacity="0.14" />

    <SolidColorBrush x:Key="TextDimSoft" Color="#6E675F" Opacity="0.14" />

    <SolidColorBrush x:Key="Accent" Color="#D97757" />
