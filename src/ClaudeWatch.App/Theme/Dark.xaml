<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Bg" Color="#171614" />
    <SolidColorBrush x:Key="Surface" Color="#201F1C" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#2A2825" />
    <SolidColorBrush x:Key="Sidebar" Color="#131211" />
    <SolidColorBrush x:Key="Line" Color="#332F2B" />
    <SolidColorBrush x:Key="LineSoft" Color="#282522" />
    <SolidColorBrush x:Key="Text" Color="#EEEAE2" />
    <SolidColorBrush x:Key="TextDim" Color="#A29B92" />
    <SolidColorBrush x:Key="TextFaint" Color="#6E675F" />
