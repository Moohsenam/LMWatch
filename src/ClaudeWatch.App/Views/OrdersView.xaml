<UserControl x:Class="ClaudeWatch.App.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,28" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="{Binding L[Ord_Title]}" Style="{StaticResource Display}" FontSize="20" />
            <TextBlock Text="{Binding OrderServiceName}" Style="{StaticResource Dim}" Margin="0,4,0,0" />

            <!-- no server set -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                    Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource Warn}"
                    Visibility="{Binding OrdersConfigured, Converter={StaticResource NotBoolVis}}">
                <TextBlock Text="{Binding L[Ord_NoServer]}" Style="{StaticResource Body}" />
            </Border>

            <!-- notice from the service -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                    Background="{DynamicResource InfoSoft}" BorderBrush="{DynamicResource Info}"
                    Visibility="{Binding HasOrderNotice, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding OrderNotice}" Style="{StaticResource Body}" />
            </Border>

            <!-- form -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                    Visibility="{Binding OrderPlaced, Converter={StaticResource NotBoolVis}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding L[Ord_Plan]}" Style="{StaticResource Caption}" />
                            <ComboBox Style="{StaticResource Picker}" Margin="0,6,0,0"
                                      ItemsSource="{Binding OrderPlans}" DisplayMemberPath="Text"
                                      SelectedItem="{Binding SelectedPlan, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding L[Ord_Months]}" Style="{StaticResource Caption}" />
                            <ComboBox Style="{StaticResource Picker}" Margin="0,6,0,0"
                                      SelectedIndex="{Binding OrderMonthsIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{Binding L[Ord_Months1]}" />
                                <ComboBoxItem Content="{Binding L[Ord_Months3]}" />
                                <ComboBoxItem Content="{Binding L[Ord_Months6]}" />
                                <ComboBoxItem Content="{Binding L[Ord_Months12]}" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding L[Ord_Name]}" Style="{StaticResource Caption}" Margin="0,16,0,0" />
                    <TextBox Style="{StaticResource Field}" Margin="0,6,0,0"
                             Text="{Binding Draft.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{Binding L[Ord_Email]}" Style="{StaticResource Caption}" Margin="0,16,0,0" />
                    <TextBox Style="{StaticResource Field}" Margin="0,6,0,0"
                             Text="{Binding Draft.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding L[Ord_ContactKind]}" Style="{StaticResource Caption}" />
                            <ComboBox Style="{StaticResource Picker}" Margin="0,6,0,0"
                                      SelectedIndex="{Binding OrderContactKindIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Telegram" />
                                <ComboBoxItem Content="WhatsApp" />
                                <ComboBoxItem Content="Email" />
                                <ComboBoxItem Content="Phone" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding L[Ord_Contact]}" Style="{StaticResource Caption}" />
                            <TextBox Style="{StaticResource Field}" Margin="0,6,0,0"
                                     Text="{Binding Draft.Contact, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding L[Ord_Country]}" Style="{StaticResource Caption}" Margin="0,16,0,0" />
                    <TextBox Style="{StaticResource Field}" Margin="0,6,0,0"
                             Text="{Binding Draft.Country, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{Binding L[Ord_Note]}" Style="{StaticResource Caption}" Margin="0,16,0,0" />
                    <TextBox Style="{StaticResource Field}" Margin="0,6,0,0" MinHeight="70"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Text="{Binding Draft.Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                        <CheckBox Style="{StaticResource Switch}"
                                  IsChecked="{Binding Draft.Eligible, Mode=TwoWay}"
                                  Content="{Binding L[Ord_Eligible]}" />
                    </Border>

                    <TextBlock Text="{Binding L[Ord_PasswordWarning]}" Style="{StaticResource Caption}"
                               Margin="0,10,0,0" FontWeight="Normal" />

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="12,10"
                            Background="{DynamicResource AlertSoft}" BorderBrush="{DynamicResource Alert}"
                            Visibility="{Binding OrderHasError, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding OrderError}" Style="{StaticResource Body}"
                                   Foreground="{DynamicResource Alert}" />
                    </Border>

                    <Button Content="{Binding L[Ord_Submit]}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding PlaceOrderCommand}" IsEnabled="{Binding OrderCanSubmit}"
                            Margin="0,16,0,0" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <!-- placed -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="28"
                    Visibility="{Binding OrderPlaced, Converter={StaticResource BoolVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding L[Ord_Done]}" Style="{StaticResource Dim}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding OrderCode}" FontFamily="Consolas, Courier New" FontSize="30"
                               FontWeight="Bold" Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Center" Margin="0,12,0,12" />
                    <TextBlock Text="{Binding L[Ord_Keep]}" Style="{StaticResource Dim}"
                               HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360" />
                    <Button Content="{Binding L[Ord_Again]}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding NewOrderCommand}" Margin="0,20,0,0"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- track -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding L[Ord_Track]}" Style="{StaticResource H2}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource Field}" Margin="0,0,8,0"
                                 Text="{Binding TrackCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="{Binding L[Ord_TrackBtn]}"
                                Style="{StaticResource SecondaryButton}" Command="{Binding TrackOrderCommand}" />
                    </Grid>
                    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Padding="12,10"
                            Margin="0,12,0,0"
                            Visibility="{Binding TrackHasAnswer, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding TrackAnswer}" Style="{StaticResource Body}" />
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
