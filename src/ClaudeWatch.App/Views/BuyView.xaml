<UserControl x:Class="ClaudeWatch.App.Views.BuyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding L[Buy_Title]}" Style="{StaticResource Display}" FontSize="20" />
                <TextBlock Text="{Binding L[Buy_Hint]}" Style="{StaticResource Dim}" Margin="0,4,0,0"
                           MaxWidth="620" HorizontalAlignment="Left" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding L[Btn_Refresh]}" Style="{StaticResource SecondaryButton}"
                    Command="{Binding LoadPricesCommand}" VerticalAlignment="Top" />
        </Grid>

        <Grid Grid.Row="1">
            <!-- nothing to show: no server, no rate, or no reaching it -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                        Visibility="{Binding ShowPriceEmpty, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding PriceEmptyText}" Style="{StaticResource Dim}"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="{Binding L[Buy_Loading]}" Style="{StaticResource Dim}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding PricesLoading, Converter={StaticResource BoolVis}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowPriceCards, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Prices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Width="268" Margin="0,0,14,14"
                                        Padding="20" VerticalAlignment="Top">
                                    <StackPanel>
                                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="4"
                                                Padding="7,2" HorizontalAlignment="Left" Margin="0,0,0,8"
                                                Visibility="{Binding Popular, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding DataContext.L[Buy_Popular],
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Accent}" />
                                        </Border>

                                        <TextBlock Text="{Binding Converter={StaticResource PlanName}}"
                                                   Style="{StaticResource Display}" FontSize="16" />

                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <TextBlock Text="{Binding Converter={StaticResource PlanPrice}}"
                                                       Style="{StaticResource Display}" FontSize="25"
                                                       Foreground="{DynamicResource Accent}" />
                                            <TextBlock Text="{Binding DataContext.L[Buy_Toman],
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       Style="{StaticResource Dim}" VerticalAlignment="Bottom"
                                                       Margin="6,0,0,4" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Converter={StaticResource PlanPeriod}}"
                                                   Style="{StaticResource Caption}" Margin="0,2,0,0" />

                                        <TextBlock Text="{Binding Converter={StaticResource PlanNote}}"
                                                   Style="{StaticResource Caption}" Margin="0,10,0,0"
                                                   TextWrapping="Wrap" />

                                        <Button Content="{Binding DataContext.L[Buy_Order],
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding DataContext.BuyPlanCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding PriceFootnote}" Style="{StaticResource Caption}"
                               Margin="2,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding L[Buy_Small]}" Style="{StaticResource Caption}"
                               Margin="2,10,0,0" TextWrapping="Wrap" MaxWidth="640"
                               HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
