<UserControl x:Class="ClaudeWatch.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,4,24,28">

            <!-- clock consent -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                    Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource Warn}"
                    Visibility="{Binding ShowClockBanner, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding L[Banner_ClockNeeded]}" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding ClockBannerText}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding L[Banner_ClockDetail]}" Style="{StaticResource Dim}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding L[Btn_ChangeNow]}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ChangeClockCommand}" />
                        <Button Content="{Binding L[Btn_SkipSession]}" Style="{StaticResource GhostButton}"
                                Command="{Binding SkipClockCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- failed change -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                    Background="{DynamicResource AlertSoft}" BorderBrush="{DynamicResource Alert}"
                    Visibility="{Binding ShowFailedBanner, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding L[Banner_Failed]}" Style="{StaticResource Body}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{Binding L[Btn_ChangeNow]}" Style="{StaticResource SmallButton}"
                            Command="{Binding ChangeClockCommand}" />
                </Grid>
            </Border>

            <!-- paused -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                    Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource Warn}"
                    Visibility="{Binding ShowPauseBanner, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding PauseUntilText}" Style="{StaticResource Body}"
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Button Grid.Column="1" Content="{Binding L[Btn_Resume]}" Style="{StaticResource SmallButton}"
                            Command="{Binding ResumeCommand}" />
                </Grid>
            </Border>

            <!-- hero -->
            <Border Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="64" Height="64" VerticalAlignment="Center">
                        <Ellipse Fill="{Binding StatusSoftBrush}" />
                        <Ellipse Width="44" Height="44" Stroke="{Binding StatusBrush}" StrokeThickness="2.5"
                                 Opacity="0.5" />
                        <Ellipse Width="18" Height="18" Fill="{Binding StatusBrush}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource Display}"
                                   Foreground="{Binding StatusBrush}" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Dim}" Margin="0,6,0,0"
                                   MaxWidth="460" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button Content="{Binding L[Btn_Open]}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenClaudeCommand}" MinWidth="168" />
                        <Button Content="{Binding L[Btn_Stop]}" Style="{StaticResource DangerButton}"
                                Command="{Binding StopClaudeCommand}" IsEnabled="{Binding CanStopClaude}"
                                MinWidth="168" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- address -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="22"
                    Visibility="{Binding ShowIpCard, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding L[Ip_Title]}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding IpSource}" Style="{StaticResource Caption}"
                                       Margin="10,0,0,0" FontWeight="Normal" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource AlertSoft}" CornerRadius="4" Padding="7,2"
                                    Margin="10,0,0,0"
                                    Visibility="{Binding ShowFirewallChip, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding FirewallStatus}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{Binding FirewallBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding IpValue}" Foreground="{Binding IpBrush}"
                                   FontFamily="Consolas, Courier New" FontSize="34" FontWeight="Bold"
                                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding IpWhere}" Style="{StaticResource Dim}" />
                            <TextBlock Text="{Binding IpNetwork}" Style="{StaticResource Caption}"
                                       Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                        </StackPanel>

                        <Border Background="{DynamicResource AlertSoft}" BorderBrush="{DynamicResource Alert}"
                                BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Visibility="{Binding ShowIpLeak, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding L[Ip_Leak]}" Style="{StaticResource Body}"
                                       Foreground="{DynamicResource Alert}" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="{Binding IpCopyLabel}" Style="{StaticResource SmallButton}"
                                Command="{Binding CopyIpCommand}" MinWidth="96" />
                        <Button Content="{Binding L[Btn_Refresh]}" Style="{StaticResource GhostButton}"
                                Command="{Binding RefreshIpCommand}" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- tiles -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding VpnBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding L[Tile_Vpn]}" Style="{StaticResource Caption}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding VpnValue}" Style="{StaticResource Body}" FontSize="14"
                                   FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding ClockBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding L[Tile_Clock]}" Style="{StaticResource Caption}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ClockValue}" Style="{StaticResource Body}" FontSize="14"
                                   FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ClockSub}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding ClaudeBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding L[Tile_Claude]}" Style="{StaticResource Caption}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ClaudeValue}" Style="{StaticResource Body}" FontSize="14"
                                   FontWeight="SemiBold" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- today -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding L[Today_Title]}" Style="{StaticResource H2}" />
                        <TextBlock Grid.Column="1" Text="{Binding TodayFooter}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding TodayHeadline}" Style="{StaticResource Body}" Margin="0,8,0,0" />

                    <ItemsControl ItemsSource="{Binding TodayStats}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="8"
                                        Padding="12,8" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Count}" FontSize="17" FontWeight="Bold"
                                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- controls -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="{Binding L[Btn_Prepare]}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding PrepareCommand}" Margin="0,0,8,8" />
                        <Button Content="{Binding L[Btn_HoldHome]}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding HoldHomeCommand}" Margin="0,0,8,8"
                                IsEnabled="{Binding ShowStandbyActions}" />
                        <Button Content="{Binding L[Btn_SkipSession]}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SkipClockCommand}" Margin="0,0,8,8"
                                Visibility="{Binding ClockRulesSuspended, Converter={StaticResource NotBoolVis}}" />
                        <Button Content="{Binding L[Btn_RestoreRules]}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RestoreClockCommand}" Margin="0,0,8,8"
                                Visibility="{Binding ClockRulesSuspended, Converter={StaticResource BoolVis}}" />
                        <Button Content="{Binding L[Btn_Refresh]}" Style="{StaticResource GhostButton}"
                                Command="{Binding RefreshCommand}" Margin="0,0,8,8" />
                    </WrapPanel>

                    <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,6,0,14" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding L[Btn_Pause]}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="{Binding L[Pause_15]}" Style="{StaticResource SmallButton}"
                                Command="{Binding PauseCommand}" CommandParameter="15" Margin="0,0,8,0" />
                        <Button Content="{Binding L[Pause_30]}" Style="{StaticResource SmallButton}"
                                Command="{Binding PauseCommand}" CommandParameter="30" Margin="0,0,8,0" />
                        <Button Content="{Binding L[Pause_60]}" Style="{StaticResource SmallButton}"
                                Command="{Binding PauseCommand}" CommandParameter="60" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- recent activity -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding L[Act_Title]}" Style="{StaticResource H2}" Margin="0,0,0,12" />

                    <TextBlock Text="{Binding L[Act_Empty]}" Style="{StaticResource Dim}"
                               Visibility="{Binding Events.Count, Converter={StaticResource EmptyVis}}" />

                    <ItemsControl ItemsSource="{Binding RecentEvents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,2,12,2"
                                            Background="{Binding Kind, Converter={StaticResource KindBrush}}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding TimeDisplay}"
                                               Style="{StaticResource Caption}" VerticalAlignment="Top" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
