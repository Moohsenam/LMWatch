<UserControl x:Class="ClaudeWatch.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding L[Proc_Title]}" Style="{StaticResource Display}" FontSize="20" />
                <TextBlock Text="{Binding L[Proc_Hint]}" Style="{StaticResource Dim}" Margin="0,4,0,0" MaxWidth="620"
                           HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="{Binding L[Btn_Refresh]}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Content="{Binding L[Proc_StopAll]}" Style="{StaticResource DangerButton}"
                        Command="{Binding StopClaudeCommand}" IsEnabled="{Binding CanStopClaude}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <TextBlock Text="{Binding L[Proc_Empty]}" Style="{StaticResource Dim}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Processes.Count, Converter={StaticResource EmptyVis}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding Processes.Count, Converter={StaticResource EmptyVis}, ConverterParameter=invert}">
                    <ItemsControl ItemsSource="{Binding Processes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}" Background="{DynamicResource SurfaceAlt}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="520" HorizontalAlignment="Left" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Width="86" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DataContext.L[Proc_Pid],
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Pid}" Style="{StaticResource Mono}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Width="92" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DataContext.L[Proc_Memory],
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding MemoryDisplay}" Style="{StaticResource Mono}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Button Grid.Column="3" VerticalAlignment="Center"
                                                Style="{StaticResource SmallButton}"
                                                Content="{Binding DataContext.L[Btn_StopOne],
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Command="{Binding DataContext.StopOneCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
