<UserControl x:Class="ClaudeWatch.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,28" MaxWidth="820" HorizontalAlignment="Left">

                <!-- ===================== one-time setup ================= -->
                <TextBlock Text="{Binding L[Setup_Title]}" Style="{StaticResource SectionLabel}" Margin="2,0,0,10" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding L[Setup_Title]}" Style="{StaticResource Body}"
                                           FontWeight="SemiBold" />
                                <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="4" Padding="7,2"
                                        Margin="10,0,0,0">
                                    <TextBlock Text="{Binding SetupStatus}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{Binding SetupBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding L[Setup_Sub]}" Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding L[Set_ClaudePath]}" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding ClaudePathDisplay}" Style="{StaticResource Caption}"
                                           FontWeight="Normal" Margin="8,0,0,0" MaxWidth="380"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <Button Content="{Binding L[Setup_Run]}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SetupEverythingCommand}"
                                    Visibility="{Binding SetupComplete, Converter={StaticResource NotBoolVis}}" />
                            <Button Content="{Binding L[Setup_Again]}" Style="{StaticResource GhostButton}"
                                    Command="{Binding SetupEverythingCommand}"
                                    Visibility="{Binding SetupComplete, Converter={StaticResource BoolVis}}" />
                            <Button Content="{Binding L[Btn_Browse]}" Style="{StaticResource GhostButton}"
                                    Command="{Binding BrowseClaudeCommand}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ====================== services ====================== -->
                <TextBlock Text="{Binding L[Svc_Switch]}" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding L[Svc_Both]}" Style="{StaticResource Caption}" />

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <CheckBox Style="{StaticResource Switch}" Content="Claude"
                                  IsChecked="{Binding ClaudeEnabled, Mode=TwoWay}" />
                        <TextBlock Text="{Binding ClaudePath}" Style="{StaticResource Caption}"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <CheckBox Style="{StaticResource Switch}" Content="ChatGPT"
                                  IsChecked="{Binding ChatGptEnabled, Mode=TwoWay}" />
                        <TextBlock Text="{Binding ChatGptPath}" Style="{StaticResource Caption}"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <TextBlock Text="{Binding L[Set_Zones]}" Style="{StaticResource Body}" />
                        <TextBlock Text="{Binding L[Svc_Enabled]}" Style="{StaticResource Caption}"
                                   Margin="0,3,0,0" />
                        <Button Content="{Binding L[Btn_Refresh]}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding FindAppsCommand}" HorizontalAlignment="Left"
                                Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- ===================== protection ===================== -->
                <TextBlock Text="{Binding L[Set_Protection]}" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="{Binding L[Set_EnforceVpn]}" Style="{StaticResource Body}" />
                                <TextBlock Text="{Binding L[Set_EnforceVpn_Sub]}" Style="{StaticResource Caption}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding Edit.EnforceVpn, Mode=TwoWay}" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="{Binding L[Set_EnforceTz]}" Style="{StaticResource Body}" />
                                <TextBlock Text="{Binding L[Set_EnforceTz_Sub]}" Style="{StaticResource Caption}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                                      IsChecked="{Binding Edit.Active.EnforceTimeZone, Mode=TwoWay}" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding L[Set_Action]}" Style="{StaticResource Body}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource Picker}"
                                      SelectedIndex="{Binding ActionIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{Binding L[Set_Action_Stop]}" />
                                <ComboBoxItem Content="{Binding L[Set_Action_Warn]}" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="{Binding L[Set_Grace]}" Style="{StaticResource Body}" />
                                <TextBlock Text="{Binding L[Set_Grace_Sub]}" Style="{StaticResource Caption}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource Picker}" VerticalAlignment="Top"
                                      SelectedIndex="{Binding GraceIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{Binding L[Set_Grace_Off]}" />
                                <ComboBoxItem Content="10" />
                                <ComboBoxItem Content="20" />
                                <ComboBoxItem Content="30" />
                                <ComboBoxItem Content="60" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <CheckBox Style="{StaticResource Switch}" Content="{Binding L[Set_GraceOverlay]}"
                                  IsChecked="{Binding Edit.ShowGraceOverlay, Mode=TwoWay}" />

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="{Binding L[Set_Tolerance]}" Style="{StaticResource Body}" />
                                <TextBlock Text="{Binding L[Set_Tolerance_Sub]}" Style="{StaticResource Caption}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource Picker}" VerticalAlignment="Top"
                                      SelectedIndex="{Binding ToleranceIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="5" />
                                <ComboBoxItem Content="10" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding L[Set_Interval]}" Style="{StaticResource Body}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource Picker}"
                                      SelectedIndex="{Binding IntervalIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="0.5" />
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="5" />
                                <ComboBoxItem Content="10" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===================== time zones ===================== -->
                <TextBlock Text="{Binding L[Set_Zones]}" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding L[Set_WorkZone]}" Style="{StaticResource Body}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource Picker}"
                                      ItemsSource="{Binding TimeZones}" DisplayMemberPath="Display"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding Edit.Active.RequiredTimeZoneId, Mode=TwoWay}" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding L[Set_HomeZone]}" Style="{StaticResource Body}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource Picker}"
                                      ItemsSource="{Binding TimeZones}" DisplayMemberPath="Display"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding Edit.Active.HomeTimeZoneId, Mode=TwoWay}" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding L[Set_TzMode]}" Style="{StaticResource Body}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource Picker}"
                                      SelectedIndex="{Binding TimeZoneModeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{Binding L[Set_TzMode_Ask]}" />
                                <ComboBoxItem Content="{Binding L[Set_TzMode_Auto]}" />
                                <ComboBoxItem Content="{Binding L[Set_TzMode_Report]}" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding L[Set_Helper]}" Style="{StaticResource Body}" />
                                    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="4" Padding="7,2"
                                            Margin="10,0,0,0">
                                        <TextBlock Text="{Binding HelperStatus}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextDim}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding L[Set_Helper_Sub]}" Style="{StaticResource Caption}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <Button Content="{Binding L[Btn_Remove]}" Style="{StaticResource GhostButton}"
                                        Command="{Binding RemoveHelperCommand}"
                                        Visibility="{Binding HelperInstalled, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===================== kill switch ==================== -->
                <TextBlock Text="{Binding L[Set_Firewall]}" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding L[Set_Firewall]}" Style="{StaticResource Body}" />
                                    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="4" Padding="7,2"
                                            Margin="10,0,0,0">
                                        <TextBlock Text="{Binding FirewallStatus}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{Binding FirewallBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding L[Set_Firewall_Sub]}" Style="{StaticResource Caption}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <CheckBox Style="{StaticResource Switch}"
                                          IsChecked="{Binding Edit.Active.EnableFirewallKillSwitch, Mode=TwoWay}" />
                                <Button Content="{Binding L[Btn_Remove]}" Style="{StaticResource GhostButton}"
                                        Command="{Binding RemoveFirewallCommand}" Margin="0,8,0,0"
                                        Visibility="{Binding FirewallReady, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== address and usage ================ -->
                <TextBlock Text="{Binding L[Ip_Title]}" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource Switch}" Content="{Binding L[Ip_Title]}"
                                  IsChecked="{Binding Edit.ShowIpPanel, Mode=TwoWay}" />

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding L[Set_Interval]}" Style="{StaticResource Body}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource Picker}"
                                      SelectedIndex="{Binding IpRefreshIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="30" />
                                <ComboBoxItem Content="60" />
                                <ComboBoxItem Content="300" />
                                <ComboBoxItem Content="900" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding L[Ip_Home]}" Style="{StaticResource Body}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding KnownHomeIp}" Style="{StaticResource Mono}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <TextBlock Text="{Binding L[Ord_Server]}" Style="{StaticResource Body}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource Field}" Margin="0,0,8,0"
                                     Text="{Binding Edit.OrdersBaseUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <Button Grid.Column="1" Content="{Binding L[Btn_Refresh]}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ReloadOrderServiceCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===================== detection ====================== -->
                <TextBlock Text="{Binding L[Set_Detection]}" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding L[Set_VpnPattern]}" Style="{StaticResource Body}" />
                        <TextBox Style="{StaticResource Field}" Margin="0,6,0,0"
                                 Text="{Binding Edit.VpnAdapterPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="{Binding L[Set_ProcPattern]}" Style="{StaticResource Body}" Margin="0,16,0,0" />
                        <TextBox Style="{StaticResource Field}" Margin="0,6,0,0"
                                 Text="{Binding Edit.Active.ProcessNamePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding L[Set_Extra]}" Style="{StaticResource Body}" />
                                <TextBox Style="{StaticResource Field}" Margin="0,6,0,0"
                                         Text="{Binding ExtraNames, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding L[Set_Excluded]}" Style="{StaticResource Body}" />
                                <TextBox Style="{StaticResource Field}" Margin="0,6,0,0"
                                         Text="{Binding ExcludedNames, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding L[Set_CommaHint]}" Style="{StaticResource Caption}" Margin="0,6,0,0" />

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,16" />

                        <CheckBox Style="{StaticResource Switch}" Content="{Binding L[Set_Tunnels]}"
                                  IsChecked="{Binding Edit.TrustTunnelAdapters, Mode=TwoWay}" />

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,16" />

                        <CheckBox Style="{StaticResource Switch}" Content="{Binding L[Set_Routed]}"
                                  IsChecked="{Binding Edit.RequireDefaultRoute, Mode=TwoWay}" />
                        <TextBlock Text="{Binding L[Set_Routed_Sub]}" Style="{StaticResource Caption}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- ==================== application ===================== -->
                <TextBlock Text="{Binding L[Set_App]}" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource Switch}" Content="{Binding L[Set_Startup]}"
                                  IsChecked="{Binding Edit.StartWithWindows, Mode=TwoWay}" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource Switch}" Content="{Binding L[Set_StartMin]}"
                                  IsChecked="{Binding Edit.StartMinimized, Mode=TwoWay}" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource Switch}" Content="{Binding L[Set_MinTray]}"
                                  IsChecked="{Binding Edit.MinimizeToTray, Mode=TwoWay}" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource Switch}" Content="{Binding L[Set_CloseTray]}"
                                  IsChecked="{Binding Edit.CloseToTray, Mode=TwoWay}" Margin="0,0,0,12" />

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,4,0,16" />

                        <CheckBox Style="{StaticResource Switch}" Content="{Binding L[Set_Notify]}"
                                  IsChecked="{Binding Edit.ShowNotifications, Mode=TwoWay}" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource Switch}" Content="{Binding L[Set_NotifyProblems]}"
                                  IsChecked="{Binding Edit.NotifyOnlyOnProblems, Mode=TwoWay}" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource Switch}" Content="{Binding L[Set_Confirm]}"
                                  IsChecked="{Binding Edit.ConfirmBeforeStopping, Mode=TwoWay}" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource Switch}" Content="{Binding L[Set_Hotkey]}"
                                  IsChecked="{Binding Edit.EnableKillHotkey, Mode=TwoWay}" />

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,16" />

                        <TextBlock Text="{Binding L[Set_ClaudePath]}" Style="{StaticResource Body}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource SurfaceAlt}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
                                    Padding="10,9" Margin="0,0,8,0">
                                <TextBlock Text="{Binding ClaudePathDisplay}" Style="{StaticResource Caption}"
                                           FontWeight="Normal" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Button Grid.Column="1" Content="{Binding L[Btn_Browse]}"
                                    Style="{StaticResource SecondaryButton}" Command="{Binding BrowseClaudeCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ====================== version ======================= -->
                <TextBlock Text="{Binding L[Upd_Section]}" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding UpdateStatusLine}"
                                       Style="{StaticResource Body}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="{Binding L[Upd_Check]}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CheckUpdateCommand}" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <CheckBox Style="{StaticResource Switch}" Content="{Binding L[Upd_Auto]}"
                                  IsChecked="{Binding Edit.CheckForUpdates, Mode=TwoWay}" />
                        <TextBlock Text="{Binding L[Upd_Auto_Sub]}" Style="{StaticResource Caption}"
                                   FontWeight="Normal" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- ==================== appearance ====================== -->
                <TextBlock Text="{Binding L[Set_Look]}" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding L[Set_Theme]}" Style="{StaticResource Body}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource Picker}"
                                      SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{Binding L[Set_Theme_Dark]}" />
                                <ComboBoxItem Content="{Binding L[Set_Theme_Light]}" />
                                <ComboBoxItem Content="{Binding L[Set_Theme_System]}" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding L[Set_Accent]}" Style="{StaticResource Body}"
                                       VerticalAlignment="Center" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding AccentOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="26" Height="26" Margin="6,0,0,0" Padding="0"
                                                Style="{StaticResource ButtonBase}"
                                                Background="{Binding Converter={StaticResource HexBrush}}"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.AccentCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding L[Set_Language]}" Style="{StaticResource Body}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource Picker}"
                                      SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="English" />
                                <ComboBoxItem Content="فارسی" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- =================== housekeeping ===================== -->
                <TextBlock Text="{Binding L[Set_Advanced]}" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding L[Set_Retention]}" Style="{StaticResource Body}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Style="{StaticResource Picker}"
                                      SelectedIndex="{Binding RetentionIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="7" />
                                <ComboBoxItem Content="14" />
                                <ComboBoxItem Content="30" />
                                <ComboBoxItem Content="90" />
                                <ComboBoxItem Content="365" />
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <TextBlock Text="{Binding L[Set_Transfer]}" Style="{StaticResource Body}" />
                        <TextBlock Text="{Binding L[Set_TransferHint]}" Style="{StaticResource Caption}"
                                   Margin="0,4,0,10" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding L[Set_Export]}" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ExportSettingsCommand}" Margin="0,0,10,0" />
                            <Button Content="{Binding L[Set_Import]}" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ImportSettingsCommand}" />
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,14" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding L[Set_DataFolder]}" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenDataFolderCommand}" Margin="0,0,10,0" />
                            <Button Content="{Binding L[Btn_Reset]}" Style="{StaticResource GhostButton}"
                                    Command="{Binding ResetCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding L[Set_ResetHint]}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- save bar -->
        <Border Grid.Row="1" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding L[Btn_Saved]}" Style="{StaticResource Body}"
                           Foreground="{DynamicResource Good}" VerticalAlignment="Center" Margin="0,0,14,0"
                           Visibility="{Binding SavedFlash, Converter={StaticResource BoolVis}}" />
                <Button Content="{Binding L[Btn_Save]}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}" MinWidth="160" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
