<UserControl x:Class="ClaudeWatch.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding L[Net_Title]}" Style="{StaticResource Display}" FontSize="20" />
                <TextBlock Text="{Binding L[Net_Hint]}" Style="{StaticResource Dim}" Margin="0,4,0,0" MaxWidth="620"
                           HorizontalAlignment="Left" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding L[Btn_Refresh]}" Style="{StaticResource SecondaryButton}"
                    Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <TextBlock Text="{Binding L[Net_Empty]}" Style="{StaticResource Dim}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Adapters.Count, Converter={StaticResource EmptyVis}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Adapters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}" Background="{DynamicResource SurfaceAlt}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                                                 Margin="2,0,12,0"
                                                 Fill="{Binding CountsAsVpn, Converter={StaticResource AdapterBrush}}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="430" HorizontalAlignment="Left" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Width="112" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Kind}" Style="{StaticResource Caption}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Border Background="{DynamicResource GoodSoft}" CornerRadius="4"
                                                        Padding="6,2" Margin="0,0,4,0"
                                                        Visibility="{Binding CountsAsVpn, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="VPN" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Good}" />
                                                </Border>
                                                <Border Background="{DynamicResource InfoSoft}" CornerRadius="4"
                                                        Padding="6,2" Margin="0,0,4,0"
                                                        Visibility="{Binding Trusted, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{Binding DataContext.L[Net_Trusted],
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Info}" />
                                                </Border>
                                                <Border Background="{DynamicResource WarnSoft}" CornerRadius="4"
                                                        Padding="6,2" Margin="0,0,4,0"
                                                        Visibility="{Binding IdleTunnel, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{Binding DataContext.L[Net_Idle],
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Warn}" />
                                                </Border>
                                                <Border Background="{DynamicResource AlertSoft}" CornerRadius="4"
                                                        Padding="6,2"
                                                        Visibility="{Binding Ignored, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{Binding DataContext.L[Net_Ignored],
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Alert}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                                    Content="{Binding DataContext.L[Btn_Trust],
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.TrustAdapterCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding Trusted, Converter={StaticResource NotBoolVis}}" />
                                            <Button Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                                    Content="{Binding DataContext.L[Btn_Untrust],
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.TrustAdapterCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding Trusted, Converter={StaticResource BoolVis}}" />
                                            <Button Style="{StaticResource SmallButton}"
                                                    Content="{Binding DataContext.L[Btn_Ignore],
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.IgnoreAdapterCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding Ignored, Converter={StaticResource NotBoolVis}}" />
                                            <Button Style="{StaticResource SmallButton}"
                                                    Content="{Binding DataContext.L[Btn_Unignore],
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.IgnoreAdapterCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding Ignored, Converter={StaticResource BoolVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
