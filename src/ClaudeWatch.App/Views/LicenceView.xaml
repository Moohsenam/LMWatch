<UserControl x:Class="ClaudeWatch.App.Views.LicenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,4,24,24" MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="{Binding L[Lic_Title]}" Style="{StaticResource Display}" FontSize="20" />
            <TextBlock Text="{Binding L[Lic_Hint]}" Style="{StaticResource Dim}" Margin="0,4,0,0"
                       TextWrapping="Wrap" />

            <!-- where the licence stands right now -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0"
                                 Fill="{Binding LicenceBrush}" />
                        <TextBlock Text="{Binding LicenceHeadline}" Style="{StaticResource Display}"
                                   FontSize="16" Foreground="{Binding LicenceBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding LicenceDetail}" Style="{StaticResource Dim}" Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- entering a key -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding L[Lic_Key]}" Style="{StaticResource Body}" />
                    <TextBox Style="{StaticResource Field}" Margin="0,6,0,0"
                             FontFamily="Consolas, Courier New" FontSize="15"
                             CharacterCasing="Upper" MaxLength="24"
                             Text="{Binding LicenceKeyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{Binding LicenceError}" Style="{StaticResource Caption}"
                               Foreground="{DynamicResource Alert}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding LicenceHasError, Converter={StaticResource BoolVis}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="{Binding L[Lic_Activate]}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ActivateCommand}" MinWidth="130" />
                        <Button Content="{Binding L[Lic_Buy]}" Style="{StaticResource GhostButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="Buy"
                                Margin="8,0,0,0" />
                        <TextBlock Text="{Binding L[Lic_Checking]}" Style="{StaticResource Dim}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Visibility="{Binding LicenceBusy, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
