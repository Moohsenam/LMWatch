<?xml version="1.0" encoding="utf-8"?>
<!--
  SafeChat has no third-party packages on purpose: everything it needs ships
  with the .NET SDK. Clearing the package sources means the build works on a
  machine with no internet access, which is the point.

  Building the installer is the one exception. It publishes self-contained, so
  the .NET runtime travels inside it and those files are downloaded rather than
  part of the SDK. tools\release.ps1 passes the source for that step by itself,
  once, and everything after it comes from the cache.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
